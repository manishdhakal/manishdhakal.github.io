<div class="repo p-2">
  <a class="gh-card" href="https://github.com/{{ include.username }}" data-gh-user="{{ include.username }}">
    <div class="gh-card-title">
      <i class="fa-brands fa-github"></i>
      <span>{{ include.username }}</span>
    </div>
    <p class="gh-card-desc"></p>
    <div class="gh-card-meta"></div>
  </a>
</div>
