{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<div class="repo p-2">
  <a class="gh-card" href="https://github.com/{{ include.repository }}" data-gh-repo="{{ include.repository }}">
    <div class="gh-card-title">
      <i class="fa-solid fa-book-bookmark"></i>
      <span>{% if show_owner %}{{ include.repository }}{% else %}{{ repo_url[1] }}{% endif %}</span>
    </div>
    <p class="gh-card-desc"></p>
    <div class="gh-card-meta"></div>
  </a>
</div>
